index 066f61b..798127e 100644
--- a/SPEC.md
+++ b/SPEC.md
@@ -192,6 +192,11 @@ one handoff, handoffs flowing back to the planner that asked, and recursion thro
   deleting an epic deletes its children (refused while any of their runs is active); `auto_approve_children` in
   `/api/settings`. Events: `handoff {text}` on a child's last run, `round_finished {round, notes, completed}` on a round.
 
+## Comments and activity
+- **Comments.** `/api/tickets/:id/comments` (GET, POST) and `/:cid` (PATCH, DELETE): body 1-10000 chars, author = the user, only the author edits or deletes. Delete is soft: the comment stays in the list as `[deleted]`. `@name` mentions (not glued to a preceding word character or dot) of workspace members by email local part are parsed into `mentions`; unknown names are ignored.
+- **Feed.** `ticket_activity` is append-only: `comment` (on creation), `status` (every real change, from `setTicket` and the PATCH route) and `run` (started/finished, from `eventLog`). Its `seq` is the item id and the order. `GET /api/tickets/:id/activity` (oldest first), `GET /api/tickets/:id/activity/stream` (SSE, new items only), `GET /api/activity?since&limit&cursor` (workspace, newest first, `{items, next_cursor}`).
+- **Agents read comments.** `commentsText` puts a `# Comments` section (oldest first, deleted ones left out) into the first message of every worker run and planner round, before the ticket.
+
 ## Guardrails
 
 - `tests/` and `evals/` are read-only to agents (harness rejects writes).
diff --git a/server/activity.ts b/server/activity.ts
new file mode 100644
index 0000000..1d2e2a8
--- /dev/null
+++ b/server/activity.ts
@@ -0,0 +1,165 @@
+import { randomUUID } from "node:crypto";
+import { Hono } from "hono";
+import { streamSSE } from "hono/streaming";
+import { db } from "./db.ts";
+
+// Ticket comments and the activity feed (SPEC "Comments and activity"). Every status change goes through recordStatus (runs.ts
+// setTicket, PATCH in app.ts), every run start/finish through recordRun (agent/events.ts), every new comment through the routes below.
+
+type Env = { Variables: { userId: string; workspaceId: string } };
+type Row = { seq: number; ticket_id: string; ticket_key: string; type: string; at: number; data: string };
+export type Item = { id: string; type: "comment" | "status" | "run"; at: number; ticket_id: string; ticket_key: string; [k: string]: unknown };
+
+const listeners = new Map<string, Set<(i: Item) => void>>();
+const KEY = "upper(substr(o.slug, 1, 3)) || '-' || t.number";
+const ROWS = `SELECT a.seq, a.ticket_id, ${KEY} AS ticket_key, a.type, a.at, a.data FROM ticket_activity a JOIN tickets t ON t.id = a.ticket_id JOIN organization o ON o.id = a.workspace_id`;
+
+const commentOf = (id: string) => {
+  const c = db.prepare("SELECT c.*, u.email AS author_email FROM ticket_comments c JOIN user u ON u.id = c.author_id WHERE c.id = ?").get(id) as Record<string, any>;
+  const deleted = c.deleted_at !== null;
+  return {
+    id: c.id, ticket_id: c.ticket_id, author_id: c.author_id, author_email: c.author_email, body: deleted ? "[deleted]" : c.body,
+    mentions: deleted ? [] : (JSON.parse(c.mentions) as string[]), created_at: c.created_at, edited_at: c.edited_at, deleted,
+  };
+};
+const item = (r: Row): Item => {
+  const data = JSON.parse(r.data);
+  const { comment_id, ...rest } = data;
+  return { id: String(r.seq), type: r.type as Item["type"], at: r.at, ticket_id: r.ticket_id, ticket_key: r.ticket_key, ...rest, ...(comment_id ? { comment: commentOf(comment_id) } : {}) };
+};
+
+function record(ticketId: string, type: Item["type"], data: object) {
+  const t = db.prepare("SELECT workspace_id FROM tickets WHERE id = ?").get(ticketId) as { workspace_id: string } | undefined;
+  if (!t) return;
+  const { lastInsertRowid } = db.prepare("INSERT INTO ticket_activity (workspace_id, ticket_id, type, at, data) VALUES (?, ?, ?, ?, ?)").run(t.workspace_id, ticketId, type, Date.now(), JSON.stringify(data));
+  const i = item(db.prepare(`${ROWS} WHERE a.seq = ?`).get(lastInsertRowid) as Row);
+  for (const fn of listeners.get(ticketId) ?? []) {
+    try {
+      fn(i);
+    } catch (e) {
+      console.error("activity listener failed", e); // a broken viewer must not break the change
+    }
+  }
+}
+
+export const recordStatus = (ticketId: string, from: string, to: string) => from !== to && record(ticketId, "status", { from, to });
+
+// A run started or finished. Eval case runs belong to their case's ticket but are not part of it.
+export function recordRun(runId: string, event: "started" | "finished", status?: string, reason?: string) {
+  const r = db.prepare("SELECT ticket_id, attempt, role, eval_run_id FROM runs WHERE id = ?").get(runId) as { ticket_id: string; attempt: number; role: string; eval_run_id: string | null } | undefined;
+  if (r && !r.eval_run_id) record(r.ticket_id, "run", { run_id: runId, attempt: r.attempt, role: r.role, event, status: status ?? null, reason: reason ?? null });
+}
+
+// "# Comments" for the first message of a worker run or planner round; "" without comments. Oldest first, deleted ones left out.
+export function commentsText(ticketId: string) {
+  const rows = db.prepare("SELECT c.body, u.email FROM ticket_comments c JOIN user u ON u.id = c.author_id WHERE c.ticket_id = ? AND c.deleted_at IS NULL ORDER BY c.created_at, c.rowid").all(ticketId) as { body: string; email: string }[];
+  return rows.length ? `# Comments\n\n${rows.map((c) => `- ${c.email}: ${c.body.replaceAll("\n", "\n  ")}`).join("\n")}` : "";
+}
+
+// Local parts of the emails of the workspace members named as @local in the text, lowercased, deduped, sorted.
+function mentionsIn(body: string, workspaceId: string) {
+  const named = new Set([...body.matchAll(/(?<![\w.])@([a-z0-9][a-z0-9._-]*)/gi)].map((m) => m[1].replace(/[._-]+$/, "").toLowerCase()));
+  const members = (db.prepare("SELECT u.email FROM member m JOIN user u ON u.id = m.userId WHERE m.organizationId = ?").all(workspaceId) as { email: string }[]).map((m) => m.email.split("@")[0].toLowerCase());
+  return [...new Set(members.filter((m) => named.has(m)))].sort();
+}
+
+export const activityRoutes = new Hono<Env>();
+
+const ticketIn = (c: { get: (k: "workspaceId") => string; req: { param: (k: string) => string } }) =>
+  db.prepare("SELECT id FROM tickets WHERE id = ? AND workspace_id = ?").get(c.req.param("id"), c.get("workspaceId")) as { id: string } | undefined;
+const bodyOf = async (c: { req: { json: () => Promise<any> } }) => {
+  const b = (await c.req.json().catch(() => null))?.body;
+  const text = typeof b === "string" ? b.trim() : "";
+  return text && text.length <= 10_000 ? text : undefined;
+};
+const BAD_BODY = { error: "body is required (1-10000 chars)" };
+
+activityRoutes.get("/api/tickets/:id/comments", (c) => {
+  const t = ticketIn(c);
+  if (!t) return c.json({ error: "not_found" }, 404);
+  return c.json((db.prepare("SELECT id FROM ticket_comments WHERE ticket_id = ? ORDER BY created_at, rowid").all(t.id) as { id: string }[]).map((r) => commentOf(r.id)));
+});
+
+activityRoutes.post("/api/tickets/:id/comments", async (c) => {
+  const t = ticketIn(c);
+  if (!t) return c.json({ error: "not_found" }, 404);
+  const body = await bodyOf(c);
+  if (!body) return c.json(BAD_BODY, 400);
+  const id = randomUUID();
+  db.prepare("INSERT INTO ticket_comments (id, ticket_id, author_id, body, mentions, created_at) VALUES (?, ?, ?, ?, ?, ?)").run(
+    id, t.id, c.get("userId"), body, JSON.stringify(mentionsIn(body, c.get("workspaceId"))), Date.now(),
+  );
+  record(t.id, "comment", { comment_id: id });
+  return c.json(commentOf(id), 201);
+});
+
+// A live comment of this ticket that the caller may change: 404 unless it exists, 403 unless they wrote it.
+function own(c: Parameters<typeof ticketIn>[0] & { get: (k: "userId") => string; req: { param: (k: string) => string } }) {
+  const t = ticketIn(c);
+  const row = t && (db.prepare("SELECT id, author_id FROM ticket_comments WHERE id = ? AND ticket_id = ? AND deleted_at IS NULL").get(c.req.param("cid"), t.id) as { id: string; author_id: string } | undefined);
+  return !row ? ({ status: 404 } as const) : row.author_id !== c.get("userId") ? ({ status: 403 } as const) : ({ id: row.id } as const);
+}
+
+activityRoutes.patch("/api/tickets/:id/comments/:cid", async (c) => {
+  const o = own(c);
+  if ("status" in o) return c.json({ error: o.status === 404 ? "not_found" : "only the author can change a comment" }, o.status);
+  const body = await bodyOf(c);
+  if (!body) return c.json(BAD_BODY, 400);
+  db.prepare("UPDATE ticket_comments SET body = ?, mentions = ?, edited_at = ? WHERE id = ?").run(body, JSON.stringify(mentionsIn(body, c.get("workspaceId"))), Date.now(), o.id);
+  return c.json(commentOf(o.id));
+});
+
+activityRoutes.delete("/api/tickets/:id/comments/:cid", (c) => {
+  const o = own(c);
+  if ("status" in o) return c.json({ error: o.status === 404 ? "not_found" : "only the author can change a comment" }, o.status);
+  db.prepare("UPDATE ticket_comments SET deleted_at = ? WHERE id = ?").run(Date.now(), o.id);
+  return c.body(null, 204);
+});
+
+activityRoutes.get("/api/tickets/:id/activity", (c) => {
+  const t = ticketIn(c);
+  if (!t) return c.json({ error: "not_found" }, 404);
+  return c.json((db.prepare(`${ROWS} WHERE a.ticket_id = ? ORDER BY a.seq`).all(t.id) as Row[]).map(item));
+});
+
+// New items of one ticket as they happen (no replay: GET the feed first).
+activityRoutes.get("/api/tickets/:id/activity/stream", (c) => {
+  const t = ticketIn(c);
+  if (!t) return c.json({ error: "not_found" }, 404);
+  return streamSSE(c, async (stream) => {
+    const queue: Item[] = [];
+    let wake = () => {};
+    let closed = false;
+    const set = listeners.get(t.id) ?? new Set();
+    const push = (i: Item) => (queue.push(i), wake());
+    listeners.set(t.id, set.add(push));
+    stream.onAbort(() => ((closed = true), wake()));
+    await stream.write(": subscribed\n\n");
+    try {
+      while (!closed) {
+        const i = queue.shift();
+        if (!i) {
+          await new Promise<void>((resolve) => (wake = resolve));
+          continue;
+        }
+        await stream.writeSSE({ id: i.id, data: JSON.stringify(i) });
+      }
+    } finally {
+      set.delete(push);
+      if (!set.size) listeners.delete(t.id);
+    }
+  });
+});
+
+// The workspace's feed, newest first. ?since=<ISO time> ?limit=1..100 (default 50) ?cursor=<next_cursor of the previous page>.
+activityRoutes.get("/api/activity", (c) => {
+  const { since, limit, cursor } = c.req.query();
+  const at = since === undefined ? 0 : Date.parse(since);
+  const n = limit === undefined ? 50 : /^\d+$/.test(limit) ? Number(limit) : 0;
+  if (Number.isNaN(at)) return c.json({ error: "since must be an ISO-8601 time" }, 400);
+  if (n < 1 || n > 100) return c.json({ error: "limit must be a whole number from 1 to 100" }, 400);
+  if (cursor !== undefined && !/^\d+$/.test(cursor)) return c.json({ error: "invalid cursor" }, 400);
+  const rows = db.prepare(`${ROWS} WHERE a.workspace_id = ? AND a.at >= ? AND a.seq < ? ORDER BY a.seq DESC LIMIT ?`).all(c.get("workspaceId"), at, cursor === undefined ? Number.MAX_SAFE_INTEGER : Number(cursor), n + 1) as Row[];
+  const page = rows.slice(0, n);
+  return c.json({ items: page.map(item), next_cursor: rows.length > n ? String(page.at(-1)!.seq) : null });
+});
