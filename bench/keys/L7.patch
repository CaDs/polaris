diff --git a/web/Activity.tsx b/web/Activity.tsx
new file mode 100644
index 0000000..0db8dfb
--- /dev/null
+++ b/web/Activity.tsx
@@ -0,0 +1,74 @@
+import { useEffect, useState, type FormEvent } from "react";
+import { api } from "./ui.tsx";
+
+type Comment = { id: string; author_id: string; author_email: string; body: string; mentions: string[]; created_at: number; edited_at: number | null; deleted: boolean };
+type Item = { id: string; type: "comment" | "status" | "run"; at: number; comment?: Comment; from?: string; to?: string; event?: string; status?: string | null; attempt?: number; role?: string };
+
+const line = (i: Item) =>
+  i.type === "status" ? `Status ${i.from} → ${i.to}`
+  : i.type === "run" ? `${i.role === "planner" ? "Planner round" : "Run"} #${i.attempt} ${i.event === "started" ? "started" : `finished (${i.status})`}`
+  : "";
+
+// Comment box and the ticket's activity feed. New items arrive over SSE; a comment edit or delete re-reads the feed.
+export function Activity({ ticketId, me }: { ticketId: string; me: string }) {
+  const [items, setItems] = useState<Item[]>([]);
+  const [error, setError] = useState("");
+  const load = () => api<Item[]>(`/api/tickets/${ticketId}/activity`).then(setItems, (e) => setError(e.message));
+  useEffect(() => {
+    void load();
+    const es = new EventSource(`/api/tickets/${ticketId}/activity/stream`);
+    es.onmessage = (m) => {
+      const i = JSON.parse(m.data) as Item;
+      setItems((cur) => (cur.some((x) => x.id === i.id) ? cur : [...cur, i]));
+    };
+    return () => es.close();
+  }, [ticketId]);
+
+  async function add(e: FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    const form = e.currentTarget;
+    setError("");
+    try {
+      await api(`/api/tickets/${ticketId}/comments`, "POST", { body: new FormData(form).get("body") });
+      form.reset();
+    } catch (err) {
+      setError((err as Error).message);
+    }
+  }
+  async function change(c: Comment, method: "PATCH" | "DELETE") {
+    const body = method === "PATCH" ? prompt("Edit comment", c.body) : undefined;
+    if (method === "PATCH" && !body?.trim()) return;
+    await api(`/api/tickets/${ticketId}/comments/${c.id}`, method, body === undefined ? undefined : { body }).then(load, (e) => setError(e.message));
+  }
+
+  return (
+    <section className="activity">
+      <h3>Activity</h3>
+      <ul>
+        {items.map((i) => (
+          <li key={i.id} className={i.type}>
+            {i.comment ? (
+              <>
+                <strong>{i.comment.author_email}</strong> <span className="muted">{new Date(i.at).toLocaleString()}{i.comment.edited_at && " · edited"}</span>
+                <p className={i.comment.deleted ? "muted" : ""}>{i.comment.body}</p>
+                {!i.comment.deleted && i.comment.author_email === me && (
+                  <span className="row">
+                    <button type="button" className="link" onClick={() => change(i.comment!, "PATCH")}>Edit</button>
+                    <button type="button" className="link" onClick={() => change(i.comment!, "DELETE")}>Delete</button>
+                  </span>
+                )}
+              </>
+            ) : (
+              <span className="muted">{new Date(i.at).toLocaleTimeString()} · {line(i)}</span>
+            )}
+          </li>
+        ))}
+      </ul>
+      <form onSubmit={add}>
+        <textarea name="body" rows={3} required maxLength={10000} placeholder="Comment. @name mentions a member; the next agent run reads it." aria-label="Comment" />
+        <button className="btn">Comment</button>
+      </form>
+      {error && <p className="error" role="alert">{error}</p>}
+    </section>
+  );
+}
