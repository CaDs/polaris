+++ b/server/migrations/009_activity.sql
@@ -0,0 +1,24 @@
+-- Ticket comments and the activity feed. Comments are soft-deleted (deleted_at); the feed is append-only, one row per item,
+-- and its seq is the order things happened in (the item id, and the pagination cursor).
+CREATE TABLE ticket_comments (
+  id         TEXT PRIMARY KEY,
+  ticket_id  TEXT NOT NULL REFERENCES tickets(id) ON DELETE CASCADE,
+  author_id  TEXT NOT NULL REFERENCES user(id) ON DELETE CASCADE,
+  body       TEXT NOT NULL,
+  mentions   TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(mentions)),
+  created_at INTEGER NOT NULL,
+  edited_at  INTEGER,
+  deleted_at INTEGER
+);
+CREATE INDEX ticket_comments_ticket ON ticket_comments(ticket_id);
+
+CREATE TABLE ticket_activity (
+  seq          INTEGER PRIMARY KEY AUTOINCREMENT,
+  workspace_id TEXT NOT NULL REFERENCES organization(id) ON DELETE CASCADE,
+  ticket_id    TEXT NOT NULL REFERENCES tickets(id) ON DELETE CASCADE,
+  type         TEXT NOT NULL CHECK (type IN ('comment', 'status', 'run')),
+  at           INTEGER NOT NULL,
+  data         TEXT NOT NULL CHECK (json_valid(data))
+);
+CREATE INDEX ticket_activity_ticket ON ticket_activity(ticket_id, seq);
+CREATE INDEX ticket_activity_workspace ON ticket_activity(workspace_id, seq);
