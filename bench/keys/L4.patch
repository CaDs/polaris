diff --git a/server/webhooks.ts b/server/webhooks.ts
new file mode 100644
index 0000000..eb57764
--- /dev/null
+++ b/server/webhooks.ts
@@ -0,0 +1,23 @@
+import { randomUUID } from "node:crypto";
+import { db } from "./db.ts";
+
+// Every ticket status change calls this (runs.ts setTicket, PATCH in app.ts). Fire and forget: the caller never waits for the
+// webhook and a failed delivery is only recorded in webhook_deliveries.
+// ponytail: one attempt, no retries or queue; add a retry table if receivers need at-least-once.
+export function notifyStatus(ticketId: string, previous: string) {
+  const t = db.prepare(`SELECT t.id, t.title, t.status, t.workspace_id, upper(substr(o.slug, 1, 3)) || '-' || t.number AS key, s.webhook_url AS url
+    FROM tickets t JOIN organization o ON o.id = t.workspace_id LEFT JOIN workspace_settings s ON s.workspace_id = t.workspace_id WHERE t.id = ?`).get(ticketId) as
+    | { id: string; title: string; status: string; workspace_id: string; key: string; url: string | null }
+    | undefined;
+  if (!t?.url || t.status === previous) return;
+  const body = JSON.stringify({ event: "ticket.status", ticket: { id: t.id, key: t.key, title: t.title, status: t.status, previous_status: previous }, at: new Date().toISOString() });
+  const record = (ok: boolean, code: number | null, error: string | null) => {
+    try {
+      db.prepare("INSERT INTO webhook_deliveries (id, workspace_id, ticket_id, url, ok, status_code, error) VALUES (?, ?, ?, ?, ?, ?, ?)").run(randomUUID(), t.workspace_id, t.id, t.url, ok ? 1 : 0, code, error);
+    } catch {} // the ticket was deleted meanwhile
+  };
+  fetch(t.url, { method: "POST", headers: { "content-type": "application/json" }, body, signal: AbortSignal.timeout(5000) }).then(
+    (res) => (res.body?.cancel(), record(res.ok, res.status, res.ok ? null : `HTTP ${res.status}`)),
+    (e: Error & { cause?: { code?: string } }) => record(false, null, `${e.message}${e.cause?.code ? ` (${e.cause.code})` : ""}`),
+  );
+}
