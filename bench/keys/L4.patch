index 0000000..46f6452
--- /dev/null
+++ b/server/migrations/009_webhooks.sql
@@ -0,0 +1,13 @@
+-- Ticket status webhooks: the workspace's target URL ('' = off) and one row per delivery attempt.
+ALTER TABLE workspace_settings ADD COLUMN webhook_url TEXT NOT NULL DEFAULT '';
+CREATE TABLE webhook_deliveries (
+  id TEXT PRIMARY KEY,
+  workspace_id TEXT NOT NULL,
+  ticket_id TEXT NOT NULL REFERENCES tickets(id) ON DELETE CASCADE,
+  url TEXT NOT NULL,
+  ok INTEGER NOT NULL,
+  status_code INTEGER,
+  error TEXT,
+  created_at INTEGER NOT NULL DEFAULT (unixepoch('subsec') * 1000)
+);
+CREATE INDEX webhook_deliveries_ws ON webhook_deliveries (workspace_id);
