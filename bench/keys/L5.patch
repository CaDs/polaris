diff --git a/server/labels.ts b/server/labels.ts
new file mode 100644
index 0000000..50f850b
--- /dev/null
+++ b/server/labels.ts
@@ -0,0 +1,14 @@
+export const MAX_LABELS = 10;
+
+// Labels as stored: trimmed, lowercased slugs [a-z0-9-]{1,30}, deduped and sorted, at most MAX_LABELS. Throws a user-facing message.
+export function normalizeLabels(input: unknown): string[] {
+  if (!Array.isArray(input)) throw new Error("labels must be an array of strings");
+  const out = new Set<string>();
+  for (const l of input) {
+    const s = typeof l === "string" ? l.trim().toLowerCase() : "";
+    if (!/^[a-z0-9-]{1,30}$/.test(s)) throw new Error(`invalid label ${JSON.stringify(l)}: labels are 1-30 chars of a-z, 0-9 and -`);
+    out.add(s);
+  }
+  if (out.size > MAX_LABELS) throw new Error(`a ticket has at most ${MAX_LABELS} labels (got ${out.size})`);
+  return [...out].sort();
+}
