diff --git a/web/Tokens.tsx b/web/Tokens.tsx
new file mode 100644
index 0000000..58bcd53
--- /dev/null
+++ b/web/Tokens.tsx
@@ -0,0 +1,65 @@
+import { useEffect, useState, type FormEvent } from "react";
+import { api } from "./ui.tsx";
+
+type ApiToken = { id: string; name: string; scope: "read" | "write"; created_at: number; last_used_at: number | null; expires_at: number | null; prefix: string };
+const when = (ms: number | null) => (ms ? new Date(ms).toLocaleString() : "never");
+
+// Personal API tokens of the signed-in user in this workspace. The secret is shown once, right after creating it.
+export function Tokens() {
+  const [tokens, setTokens] = useState<ApiToken[]>([]);
+  const [secret, setSecret] = useState("");
+  const [error, setError] = useState("");
+  const load = () => api<ApiToken[]>("/api/tokens").then(setTokens, (e) => setError(e.message));
+  useEffect(() => void load(), []);
+
+  async function create(e: FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    const f = Object.fromEntries(new FormData(e.currentTarget)) as Record<string, string>;
+    setError("");
+    try {
+      const t = await api<ApiToken & { token: string }>("/api/tokens", "POST", { name: f.name, scope: f.scope, expires_in_days: f.days ? Number(f.days) : null });
+      setSecret(t.token);
+      e.currentTarget.reset();
+      await load();
+    } catch (err) {
+      setError((err as Error).message);
+    }
+  }
+
+  async function revoke(t: ApiToken) {
+    if (!confirm(`Revoke "${t.name}"? Anything using it stops working.`)) return;
+    await api(`/api/tokens/${t.id}`, "DELETE").then(load, (e) => setError(e.message));
+  }
+
+  return (
+    <section className="tokens">
+      <h2>API tokens</h2>
+      <p className="muted">Send <code>Authorization: Bearer &lt;token&gt;</code> to use the API as yourself in this workspace. A read token may only GET.</p>
+      {secret && (
+        <p role="status" className="secret">
+          Copy it now, it is not shown again: <code className="mono">{secret}</code>
+        </p>
+      )}
+      <ul>
+        {tokens.map((t) => (
+          <li key={t.id}>
+            <strong>{t.name}</strong> <span className="badge">{t.scope}</span> <span className="mono muted">{t.prefix}…</span>
+            <span className="hint">created {when(t.created_at)} · last used {when(t.last_used_at)} · expires {when(t.expires_at)}</span>
+            <button type="button" className="link" onClick={() => revoke(t)}>Revoke</button>
+          </li>
+        ))}
+        {tokens.length === 0 && <li className="muted">No tokens yet.</li>}
+      </ul>
+      <form onSubmit={create} className="row">
+        <input name="name" placeholder="Name" required maxLength={100} aria-label="Token name" />
+        <select name="scope" aria-label="Scope" defaultValue="read">
+          <option value="read">read</option>
+          <option value="write">write</option>
+        </select>
+        <input name="days" type="number" min={1} max={365} placeholder="Expires in days" aria-label="Expires in days" />
+        <button className="btn">Create token</button>
+      </form>
+      {error && <p className="error" role="alert">{error}</p>}
+    </section>
+  );
+}
