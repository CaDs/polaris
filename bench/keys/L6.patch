@@ -0,0 +1,15 @@
+-- Personal API tokens (Authorization: Bearer aht_...). Only the sha256 of the secret is stored; `prefix` is its first 8 chars, for display.
+-- A token acts as its user in the workspace it was created in. Revoking deletes the row.
+CREATE TABLE api_tokens (
+  id           TEXT PRIMARY KEY,
+  user_id      TEXT NOT NULL REFERENCES user(id) ON DELETE CASCADE,
+  workspace_id TEXT NOT NULL REFERENCES organization(id) ON DELETE CASCADE,
+  name         TEXT NOT NULL,
+  scope        TEXT NOT NULL CHECK (scope IN ('read', 'write')),
+  token_hash   TEXT NOT NULL UNIQUE,
+  prefix       TEXT NOT NULL,
+  created_at   INTEGER NOT NULL,
+  last_used_at INTEGER,
+  expires_at   INTEGER
+);
+CREATE INDEX api_tokens_owner ON api_tokens(user_id, workspace_id);
diff --git a/server/tokens.ts b/server/tokens.ts
new file mode 100644
index 0000000..c8c724c
--- /dev/null
+++ b/server/tokens.ts
@@ -0,0 +1,64 @@
+import { createHash, randomBytes, randomUUID } from "node:crypto";
+import { Hono } from "hono";
+import { db } from "./db.ts";
+
+// Personal API tokens. The secret is shown once, at creation; the table keeps only its sha256.
+const sha256 = (s: string) => createHash("sha256").update(s).digest("hex");
+const DAY = 86_400_000;
+const MAX_TOKENS = 20; // per user and workspace
+const RATE = 100; // authenticated requests per token per minute
+// ponytail: in-memory fixed windows, reset on restart; move to the DB if the server ever runs as several processes.
+const windows = new Map<string, { start: number; n: number }>();
+
+type TokenRow = { id: string; user_id: string; workspace_id: string; scope: "read" | "write"; expires_at: number | null };
+
+// An Authorization header value → the token's user and workspace, or the error response to send.
+export function authenticate(header: string, method: string): { userId: string; workspaceId: string; tokenId: string } | { error: string; status: 401 | 403 | 429; retryAfter?: number } {
+  const secret = /^Bearer (aht_[A-Za-z0-9_-]+)$/.exec(header)?.[1];
+  const t = secret && (db.prepare("SELECT id, user_id, workspace_id, scope, expires_at FROM api_tokens WHERE token_hash = ?").get(sha256(secret)) as TokenRow | undefined);
+  if (!t) return { error: "unauthorized", status: 401 };
+  if (t.expires_at !== null && t.expires_at <= Date.now()) return { error: "token expired", status: 401 };
+  if (!db.prepare("SELECT 1 FROM member WHERE userId = ? AND organizationId = ?").get(t.user_id, t.workspace_id)) return { error: "unauthorized", status: 401 };
+  const now = Date.now();
+  const start = now - (now % 60_000);
+  const w = windows.get(t.id)?.start === start ? windows.get(t.id)! : { start, n: 0 };
+  windows.set(t.id, w);
+  if (++w.n > RATE) return { error: "rate limit exceeded: 100 requests per minute per token", status: 429, retryAfter: Math.max(1, Math.ceil((start + 60_000 - now) / 1000)) };
+  db.prepare("UPDATE api_tokens SET last_used_at = ? WHERE id = ?").run(now, t.id);
+  if (t.scope === "read" && method !== "GET" && method !== "HEAD") return { error: "this token has the read scope: only GET requests are allowed", status: 403 };
+  return { userId: t.user_id, workspaceId: t.workspace_id, tokenId: t.id };
+}
+
+type Env = { Variables: { userId: string; workspaceId: string; tokenId?: string } };
+export const tokenRoutes = new Hono<Env>();
+
+// Tokens are managed with a session only: a token cannot mint, list or revoke tokens.
+tokenRoutes.use("*", async (c, next) => (c.get("tokenId") ? c.json({ error: "API tokens cannot manage tokens: use a session" }, 403) : next()));
+
+tokenRoutes.get("/", (c) =>
+  c.json(db.prepare("SELECT id, name, scope, created_at, last_used_at, expires_at, prefix FROM api_tokens WHERE user_id = ? AND workspace_id = ? ORDER BY created_at, rowid").all(c.get("userId"), c.get("workspaceId"))),
+);
+
+tokenRoutes.post("/", async (c) => {
+  const b = await c.req.json().catch(() => null);
+  const name = typeof b?.name === "string" ? b.name.trim() : "";
+  const days = b?.expires_in_days ?? null;
+  if (!name || name.length > 100) return c.json({ error: "name is required (1-100 chars)" }, 400);
+  if (b.scope !== "read" && b.scope !== "write") return c.json({ error: 'scope must be "read" or "write"' }, 400);
+  if (days !== null && (!Number.isInteger(days) || days < 1 || days > 365)) return c.json({ error: "expires_in_days must be a whole number from 1 to 365" }, 400);
+  if ((db.prepare("SELECT COUNT(*) AS n FROM api_tokens WHERE user_id = ? AND workspace_id = ?").get(c.get("userId"), c.get("workspaceId")) as { n: number }).n >= MAX_TOKENS)
+    return c.json({ error: `at most ${MAX_TOKENS} tokens per workspace: revoke one first` }, 409);
+  const secret = `aht_${randomBytes(32).toString("base64url")}`;
+  const now = Date.now();
+  const id = randomUUID();
+  db.prepare("INSERT INTO api_tokens (id, user_id, workspace_id, name, scope, token_hash, prefix, created_at, expires_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)").run(
+    id, c.get("userId"), c.get("workspaceId"), name, b.scope, sha256(secret), secret.slice(0, 8), now, days === null ? null : now + days * DAY,
+  );
+  const row = db.prepare("SELECT id, name, scope, created_at, last_used_at, expires_at, prefix FROM api_tokens WHERE id = ?").get(id);
+  return c.json({ ...row, token: secret }, 201);
+});
+
+tokenRoutes.delete("/:id", (c) => {
+  const r = db.prepare("DELETE FROM api_tokens WHERE id = ? AND user_id = ? AND workspace_id = ?").run(c.req.param("id"), c.get("userId"), c.get("workspaceId"));
+  return r.changes ? c.body(null, 204) : c.json({ error: "not_found" }, 404);
+});
