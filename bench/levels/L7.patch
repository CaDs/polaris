+test("GET /api/tickets/:id/activity/stream pushes new items live (and only that ticket's)", async () => {
+  const t = await mk(alice, "live");
+  const other = await mk(alice, "not watched");
+  await comment(alice, t.id, "old comment, before subscribing");
+  assert.equal((await request("GET", `/api/tickets/${t.id}/activity/stream`, carol)).status, 404);
+
+  const res = await request("GET", `/api/tickets/${t.id}/activity/stream`, bob);
+  assert.equal(res.status, 200);
+  assert.match(res.headers.get("content-type") ?? "", /text\/event-stream/);
+  const reader = res.body!.getReader();
+  const decoder = new TextDecoder();
+  let buffer = "";
+  const seen: any[] = [];
+  let connected = false; // the server sends an initial SSE comment once it listens
+  const pump = (async () => {
+    for (;;) {
+      const { value, done } = await reader.read();
+      if (done) return;
+      connected = true;
+      buffer += decoder.decode(value, { stream: true });
+      for (let i = buffer.indexOf("\n\n"); i >= 0; i = buffer.indexOf("\n\n")) {
+        const data = buffer.slice(0, i).split("\n").filter((l) => l.startsWith("data:")).map((l) => l.slice(5).trim()).join("\n");
+        buffer = buffer.slice(i + 2);
+        if (data) seen.push(JSON.parse(data));
+      }
+    }
+  })().catch(() => {});
+  try {
+    await until("the stream to start", async () => connected);
+    const posted = await comment(alice, t.id, "posted after subscribing");
+    const item = await until("the comment on the stream", async () => seen.find((i) => i.type === "comment"));
+    assert.deepEqual([item.comment.id, item.comment.body, item.ticket_id], [posted.id, "posted after subscribing", t.id]);
+    await call("PATCH", `/api/tickets/${t.id}`, alice, { status: "review" });
+    const status = await until("the status change on the stream", async () => seen.find((i) => i.type === "status"));
+    assert.deepEqual([status.from, status.to], ["todo", "review"]);
+    await comment(alice, other.id, "elsewhere");
+    await call("PATCH", `/api/tickets/${other.id}`, alice, { status: "done" });
+    await sleep(300);
+    assert.deepEqual(brief(seen), ["comment posted after subscribing", "status todo>review"]); // no replay of old items, nothing from other tickets
+    const ids = (await feed(alice, t.id)).map((i) => i.id);
+    assert.deepEqual(seen.map((i) => i.id), ids.slice(-2)); // same items, same ids as the feed
+  } finally {
+    await reader.cancel().catch(() => {});
+    await pump;
+  }
+});
