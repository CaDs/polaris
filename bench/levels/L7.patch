+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import { mkdtempSync, realpathSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+// Ticket comments, @mentions, an activity feed (per ticket and per workspace, paginated), live updates over SSE,
+// and human comments in the agent's first message.
+process.env.HARNESS_PROVIDER = "fake"; // the demo worker writes notes.txt (and ok.txt on a retry); the demo planner creates a.txt and b.txt
+process.env.HARNESS_SANDBOX = "host";
+process.env.HARNESS_CONCURRENCY = "2";
+process.env.HARNESS_DATA_DIR = mkdtempSync(join(tmpdir(), "act-data-"));
+const { app } = await import("../server/app.ts");
+const { db } = await import("../server/db.ts");
+
+const origin = "http://localhost:5173";
+async function request(method: string, path: string, cookie = "", body?: unknown) {
+  return app.request(path, { method, headers: { cookie, origin, "content-type": "application/json" }, body: body === undefined ? undefined : JSON.stringify(body) });
+}
+async function call(method: string, path: string, cookie = "", body?: unknown) {
+  const res = await request(method, path, cookie, body);
+  const set = res.headers.getSetCookie().map((c) => c.split(";")[0]).join("; ");
+  return { status: res.status, body: (await res.json().catch(() => null)) as any, cookie: set || cookie };
+}
+async function signUp(name: string) {
+  return (await call("POST", "/api/auth/sign-up/email", "", { email: `${name}@x.dev`, password: "password-123", name })).cookie;
+}
+async function workspace(name: string) {
+  return (await call("POST", "/api/auth/organization/create", await signUp(name), { name, slug: name })).cookie;
+}
+// A second user in an existing workspace (members are added straight in the database, there is no invite flow).
+async function joinAs(name: string, slug: string) {
+  const cookie = await signUp(name);
+  const user = db.prepare("SELECT id FROM user WHERE email = ?").get(`${name}@x.dev`) as { id: string };
+  const org = db.prepare("SELECT id FROM organization WHERE slug = ?").get(slug) as { id: string };
+  db.prepare("INSERT INTO member (id, organizationId, userId, role, createdAt) VALUES (?, ?, ?, 'member', ?)").run(`m-${name}`, org.id, user.id, new Date().toISOString());
+  return (await call("POST", "/api/auth/organization/set-active", cookie, { organizationId: org.id })).cookie;
+}
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+async function until<T>(what: string, fn: () => Promise<T | false | undefined>, ms = 60_000): Promise<T> {
+  for (const end = Date.now() + ms; Date.now() < end; await sleep(50)) {
+    const v = await fn();
+    if (v) return v;
+  }
+  assert.fail(`timed out waiting for ${what}`);
+}
+
+const repo = realpathSync(mkdtempSync(join(tmpdir(), "act-repo-")));
+writeFileSync(join(repo, "README.md"), "hi\n");
+execFileSync("sh", ["-c", "git init -q -b main && git add -A && git -c user.name=t -c user.email=t@t commit -q -m init"], { cwd: repo });
+const gate = (who: string, test_command: string, extra: Record<string, unknown> = {}) => call("PUT", "/api/settings", who, { repo_path: repo, setup_command: "", test_command, ...extra });
+
+const alice = await workspace("alice");
+const bob = await joinAs("bob", "alice");
+const carol = await workspace("carol"); // another workspace entirely
+await gate(alice, "test -f ok.txt");
+
+const mk = async (who: string, title: string, extra: Record<string, unknown> = {}) => (await call("POST", "/api/tickets", who, { title, ...extra })).body;
+const feed = async (who: string, ticketId: string) => {
+  const r = await call("GET", `/api/tickets/${ticketId}/activity`, who);
+  assert.equal(r.status, 200);
+  return r.body as any[];
+};
+// One short line per feed item, to compare whole sequences.
+const brief = (items: any[]) =>
+  items.map((i) => (i.type === "status" ? `status ${i.from}>${i.to}` : i.type === "run" ? `run ${i.event}${i.event === "finished" ? ` ${i.status}` : ""} #${i.attempt}` : `comment ${i.comment.body}`));
+const statusOnly = (items: any[]) => brief(items.filter((i) => i.type === "status"));
+const comment = async (who: string, ticketId: string, body: string) => {
+  const r = await call("POST", `/api/tickets/${ticketId}/comments`, who, { body });
+  assert.equal(r.status, 201, JSON.stringify(r.body));
+  return r.body;
+};
+const events = (runId: string) =>
+  (db.prepare("SELECT type, payload FROM events WHERE run_id = ? ORDER BY seq").all(runId) as { type: string; payload: string }[]).map((e) => ({ type: e.type, p: JSON.parse(e.payload) }));
+const task = (runId: string) => events(runId).find((e) => e.type === "run_started")!.p.task as string;
