+test("GET /api/activity: workspace-wide, newest first, since, limit and cursor pagination", async () => {
+  const dana = await workspace("dana");
+  await call("PUT", "/api/settings", dana, { repo_path: repo, setup_command: "", test_command: "true" });
+  const t = await mk(dana, "pager");
+  const u = await mk(dana, "pager two");
+  await call("PATCH", `/api/tickets/${t.id}`, dana, { status: "review" });
+  await comment(dana, t.id, "c1");
+  await call("PATCH", `/api/tickets/${u.id}`, dana, { status: "failed" });
+  await comment(dana, u.id, "c2");
+  await call("PATCH", `/api/tickets/${t.id}`, dana, { status: "done" });
+  await comment(dana, t.id, "c3");
+  await call("PATCH", `/api/tickets/${u.id}`, dana, { status: "todo" });
+
+  const page = async (qs: string, who = dana) => {
+    const r = await call("GET", `/api/activity${qs}`, who);
+    assert.equal(r.status, 200, `${qs}: ${JSON.stringify(r.body)}`);
+    return r.body as { items: any[]; next_cursor: string | null };
+  };
+  const all = await page("?limit=100");
+  assert.equal(all.next_cursor, null);
+  assert.deepEqual(brief(all.items), ["status failed>todo", "comment c3", "status review>done", "comment c2", "status todo>failed", "comment c1", "status todo>review"]); // newest first
+  assert.deepEqual(all.items.map((i) => i.ticket_key), ["DAN-2", "DAN-1", "DAN-1", "DAN-2", "DAN-2", "DAN-1", "DAN-1"]);
+  assert.ok(all.items.every((i) => typeof i.ticket_id === "string" && typeof i.at === "number"));
+  assert.equal((await page("")).items.length, 7); // the default limit is generous
+
+  // Walk it in pages of 3; an item that arrives meanwhile neither repeats nor shifts later pages.
+  const first = await page("?limit=3");
+  assert.equal(first.items.length, 3);
+  assert.equal(typeof first.next_cursor, "string");
+  await comment(dana, t.id, "arrives between pages");
+  const second = await page(`?limit=3&cursor=${encodeURIComponent(first.next_cursor!)}`);
+  const third = await page(`?limit=3&cursor=${encodeURIComponent(second.next_cursor!)}`);
+  assert.equal(third.next_cursor, null);
+  assert.deepEqual([...first.items, ...second.items, ...third.items].map((i) => i.id), all.items.map((i) => i.id));
+  assert.equal((await page("?limit=100")).items.length, 8);
+  assert.equal((await page("?limit=7")).next_cursor !== null, true);
+  assert.equal((await page("?limit=8")).next_cursor, null);
+
+  // since: only items recorded at or after it.
+  await sleep(20);
+  const since = new Date().toISOString();
+  await sleep(20);
+  await comment(dana, u.id, "after since");
+  await call("PATCH", `/api/tickets/${u.id}`, dana, { status: "done" });
+  const recent = await page(`?since=${encodeURIComponent(since)}`);
+  assert.deepEqual(brief(recent.items), ["status todo>done", "comment after since"]);
+  assert.equal((await page(`?since=${encodeURIComponent(new Date(Date.now() + 60_000).toISOString())}`)).items.length, 0);
+
+  for (const bad of ["?since=yesterday", "?limit=0", "?limit=101", "?limit=abc", "?limit=2.5", "?cursor=garbage-cursor"])
+    assert.equal((await call("GET", `/api/activity${bad}`, dana)).status, 400, bad);
+  // Isolation: the other workspaces never show up here, and this one never shows up there.
+  assert.equal((await page("?limit=100")).items.every((i) => i.ticket_key.startsWith("DAN-")), true);
+  assert.equal((await page("?limit=100", carol)).items.some((i) => i.ticket_key.startsWith("DAN-")), false);
+  assert.equal((await call("GET", "/api/activity", "")).status, 401);
+});
