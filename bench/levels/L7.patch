+  await call("DELETE", `/api/tickets/${t.id}/comments/${dropped.id}`, alice);
+  const run = (await call("POST", `/api/tickets/${t.id}/runs`, alice)).body;
+  await until("review", async () => (await call("GET", `/api/tickets/${t.id}`, alice)).body.status === "review");
+  const first = task(run.id);
+  assert.match(first, /# Comments\n/);
+  assert.ok(first.indexOf("alice@x.dev: Please keep it short.") > first.indexOf("# Comments"));
+  assert.ok(first.indexOf("bob@x.dev: Use the house style.") > first.indexOf("alice@x.dev: Please keep it short.")); // oldest first
+  assert.equal(first.includes("never mind this one"), false); // deleted comments are not passed on
+  assert.ok(first.indexOf("# Comments") < first.indexOf("# Task"));
+  assert.ok(first.indexOf("Write the notes.") > first.indexOf("# Comments"));
+
+  // A reject, a new comment (and an edit), then the next run sees the current comments.
+  await call("POST", `/api/tickets/${t.id}/reject`, alice, { note: "try again" });
+  const late = await comment(bob, t.id, "Also add a trailing newline.");
+  await call("PATCH", `/api/tickets/${t.id}/comments/${late.id}`, bob, { body: "Also add a trailing newline, please." });
+  const again = (await call("POST", `/api/tickets/${t.id}/runs`, alice)).body;
+  await until("review again", async () => (await call("GET", `/api/tickets/${t.id}`, alice)).body.status === "review");
+  assert.match(task(again.id), /bob@x\.dev: Also add a trailing newline, please\./);
+  assert.match(task(again.id), /alice@x\.dev: Please keep it short\./);
+
+  // A ticket without comments gets no empty section.
+  const bare = await mk(alice, "no comments");
+  const bareRun = (await call("POST", `/api/tickets/${bare.id}/runs`, alice)).body;
+  await until("bare review", async () => (await call("GET", `/api/tickets/${bare.id}`, alice)).body.status === "review");
+  assert.equal(task(bareRun.id).includes("# Comments"), false);
+
+  // Planner rounds get them too.
+  await gate(alice, "test -f a.txt || test -f b.txt || test -f notes.txt"); // its children pass the gate and wait in review
+  const e = await mk(alice, "Epic with remarks", { kind: "epic", spec: "PARALLEL" });
+  await comment(alice, e.id, "Keep the plan to two tickets.");
+  const round = (await call("POST", `/api/tickets/${e.id}/runs`, alice)).body;
+  await until("round 1 finished", async () => (await call("GET", `/api/tickets/${e.id}`, alice)).body.runs[0]?.status === "passed");
+  assert.match(task(round.id), /# Comments\n\n- alice@x\.dev: Keep the plan to two tickets\./);
+});
