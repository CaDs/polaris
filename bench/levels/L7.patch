+test("the planner path: an epic, its children and their auto-approved merges are all in the feeds", async () => {
+  await gate(alice, "test -f a.txt || test -f b.txt", { auto_approve_children: true });
+  const e = await mk(alice, "Plan two files", { spec: "PARALLEL", kind: "epic" });
+  assert.equal((await call("POST", `/api/tickets/${e.id}/runs`, alice)).status, 201);
+  await until("epic review", async () => (await call("GET", `/api/tickets/${e.id}`, alice)).body.status === "review");
+  const kids = (await call("GET", `/api/tickets/${e.id}`, alice)).body.children as { id: string }[];
+  assert.equal(kids.length, 2);
+  for (const k of kids) {
+    const items = await feed(alice, k.id);
+    assert.deepEqual(statusOnly(items), ["status todo>running", "status running>review", "status review>done"]);
+    assert.deepEqual(brief(items.filter((i) => i.type === "run")), ["run started #1", "run finished passed #1"]);
+  }
+  const items = await feed(alice, e.id);
+  assert.deepEqual(statusOnly(items), ["status todo>running", "status running>review"]); // the planner's later rounds do not repeat running
+  const rounds = items.filter((i) => i.type === "run");
+  assert.ok(rounds.length >= 4 && rounds.every((i) => i.role === "planner"));
+  assert.equal(rounds.filter((i) => i.event === "started").length, rounds.filter((i) => i.event === "finished").length);
+  assert.equal((await call("POST", `/api/tickets/${e.id}/approve`, alice)).status, 200);
+  assert.deepEqual(statusOnly(await feed(alice, e.id)), ["status todo>running", "status running>review", "status review>done"]);
+});
