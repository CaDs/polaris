+test("the activity feed records comments, every status-change path and run start/finish, in order, exactly once", async () => {
+  // Plain user edits: only real changes count.
+  const u = await mk(alice, "edited by a user");
+  assert.deepEqual(await feed(alice, u.id), []); // creating a ticket is not activity
+  await call("PATCH", `/api/tickets/${u.id}`, alice, { title: "renamed" });
+  await call("PATCH", `/api/tickets/${u.id}`, alice, { status: "todo" });
+  await call("PATCH", `/api/tickets/${u.id}`, alice, { status: "review" });
+  await call("PATCH", `/api/tickets/${u.id}`, alice, { status: "review", title: "again" });
+  await comment(bob, u.id, "looks fine");
+  await call("PATCH", `/api/tickets/${u.id}`, alice, { status: "done" });
+  const items = await feed(alice, u.id);
+  assert.deepEqual(brief(items), ["status todo>review", "comment looks fine", "status review>done"]);
+  assert.ok(items.every((i) => i.ticket_id === u.id && typeof i.at === "number" && i.id !== undefined));
+  assert.deepEqual(items.map((i) => i.at), [...items.map((i) => i.at)].sort((a, b) => a - b));
+  assert.equal(new Set(items.map((i) => i.id)).size, 3);
+  assert.equal(items[1].comment.author_email, "bob@x.dev");
+  // A deleted comment stays in the feed as "[deleted]".
+  const gone = await comment(alice, u.id, "oops");
+  await call("DELETE", `/api/tickets/${u.id}/comments/${gone.id}`, alice);
+  assert.equal((await feed(alice, u.id)).at(-1).comment.body, "[deleted]");
+  assert.equal((await call("GET", `/api/tickets/${u.id}/activity`, carol)).status, 404);
+
+  // A run whose first attempt fails the gate and is retried automatically; then approve.
+  const r = await mk(alice, "retry me");
+  await call("POST", `/api/tickets/${r.id}/runs`, alice);
+  await until("review", async () => (await call("GET", `/api/tickets/${r.id}`, alice)).body.status === "review");
+  const expected = ["status todo>running", "run started #1", "run finished failed #1", "run started #2", "run finished passed #2", "status running>review"]; // no running>running for the retry
+  await until("feed", async () => (await feed(alice, r.id)).length >= expected.length);
+  assert.deepEqual(brief(await feed(alice, r.id)), expected);
+  const runItem = (await feed(alice, r.id)).find((i) => i.event === "finished" && i.attempt === 1);
+  assert.deepEqual([runItem.role, runItem.status, typeof runItem.run_id], ["worker", "failed", "string"]);
+  assert.match(runItem.reason, /ok\.txt/);
+  assert.equal((await call("POST", `/api/tickets/${r.id}/approve`, alice)).status, 200);
+  assert.deepEqual(brief(await feed(alice, r.id)), [...expected, "status review>done"]);
+
+  // Reject.
+  const j = await mk(alice, "reject me");
+  await gate(alice, "test -f notes.txt");
+  await call("POST", `/api/tickets/${j.id}/runs`, alice);
+  await until("review", async () => (await call("GET", `/api/tickets/${j.id}`, alice)).body.status === "review");
+  assert.equal((await call("POST", `/api/tickets/${j.id}/reject`, alice, { note: "no" })).status, 200);
+  await until("feed", async () => (await feed(alice, j.id)).at(-1)?.to === "todo");
+  assert.deepEqual(brief(await feed(alice, j.id)), ["status todo>running", "run started #1", "run finished passed #1", "status running>review", "status review>todo"]);
+
+  // Cancel a running run.
+  const s = await mk(alice, "slow cancel");
+  const run = (await call("POST", `/api/tickets/${s.id}/runs`, alice)).body;
+  await until("run started", async () => (await feed(alice, s.id)).some((i) => i.event === "started"));
+  assert.equal((await call("POST", `/api/runs/${run.id}/cancel`, alice)).status, 200);
+  await until("todo", async () => (await call("GET", `/api/tickets/${s.id}`, alice)).body.status === "todo");
+  await until("feed", async () => (await feed(alice, s.id)).length >= 4);
+  assert.deepEqual(brief(await feed(alice, s.id)), ["status todo>running", "run started #1", "run finished cancelled #1", "status running>todo"]);
+});
