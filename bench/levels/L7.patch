+  assert.equal((await call("DELETE", `/api/tickets/${t.id}/comments/${c1.body.id}`, bob)).status, 403);
+  assert.equal((await call("PATCH", `/api/tickets/${t.id}/comments/${c1.body.id}`, alice, { body: "" })).status, 400);
