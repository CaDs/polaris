+test("@mentions: workspace members by email local part; unknown names, other workspaces and email addresses are ignored", async () => {
+  const t = await mk(alice, "mentions");
+  const m = async (body: string) => (await comment(alice, t.id, body)).mentions;
+  assert.deepEqual(await m("@bob can you look?"), ["bob"]);
+  assert.deepEqual(await m("cc @Bob and @ALICE, thanks"), ["alice", "bob"]); // case-insensitive, deduped, sorted
+  assert.deepEqual(await m("@bob @bob @bob"), ["bob"]);
+  assert.deepEqual(await m("(@bob)."), ["bob"]);
+  assert.deepEqual(await m("ask @bob."), ["bob"]); // trailing punctuation is not part of the name
+  assert.deepEqual(await m("@nobody and @carol are not members"), []); // unknown, and a member of another workspace only
+  assert.deepEqual(await m("mail bob@alice.dev or ping@bob"), []); // an @ glued to a word is not a mention
+  assert.deepEqual(await m("no mentions here"), []);
+  const c = await comment(alice, t.id, "first @nobody");
+  const edited = await call("PATCH", `/api/tickets/${t.id}/comments/${c.id}`, alice, { body: "now @bob" });
+  assert.deepEqual(edited.body.mentions, ["bob"]); // recomputed on edit
+  assert.deepEqual((await call("GET", `/api/tickets/${t.id}/comments`, alice)).body.at(-1).mentions, ["bob"]);
+});
