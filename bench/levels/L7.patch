+  const other = await mk(alice, "another ticket");
+  const c1 = await call("POST", `/api/tickets/${t.id}/comments`, alice, { body: "  first thoughts  " });
+  assert.equal(c1.status, 201);
+  assert.deepEqual(Object.keys(c1.body).sort(), ["author_email", "author_id", "body", "created_at", "deleted", "edited_at", "id", "mentions", "ticket_id"]);
+  assert.deepEqual([c1.body.body, c1.body.author_email, c1.body.ticket_id, c1.body.deleted, c1.body.edited_at, c1.body.mentions], ["first thoughts", "alice@x.dev", t.id, false, null, []]);
+  assert.equal(typeof c1.body.created_at, "number");
+  const c2 = (await call("POST", `/api/tickets/${t.id}/comments`, bob, { body: "second, from bob" })).body; // any member can comment
+  assert.equal(c2.author_email, "bob@x.dev");
+
+  for (const bad of [{}, { body: "" }, { body: "   " }, { body: 5 }, { body: null }, { body: "x".repeat(10_001) }])
+    assert.equal((await call("POST", `/api/tickets/${t.id}/comments`, alice, bad)).status, 400, JSON.stringify(bad).slice(0, 40));
+  assert.equal((await call("POST", `/api/tickets/${t.id}/comments`, alice, { body: "x".repeat(10_000) })).status, 201);
+
+  const list = (await call("GET", `/api/tickets/${t.id}/comments`, bob)).body;
+  assert.deepEqual(list.slice(0, 2).map((c: any) => c.body), ["first thoughts", "second, from bob"]); // oldest first
+  assert.equal(list.length, 3);
