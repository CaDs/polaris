BETTER_AUTH_SECRET=change-me-to-32-plus-random-chars
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
# HOST=127.0.0.1           # interface to listen on; 0.0.0.0 exposes Polaris to your network
# PORT=3000
# POLARIS_OPEN_SIGNUP=1     # allow sign-ups after the first (owner) account

# 64 hex chars (openssl rand -hex 32). Encrypts provider API keys / OAuth tokens at rest.
POLARIS_SECRET_KEY=

# DB_PATH=polaris.db
# POLARIS_DATA_DIR=data     # worktrees, wikis, run data
# POLARIS_CONCURRENCY=2     # runs at the same time

# Fallback provider for workspaces without one (also what `npm run agent` uses)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=       # e.g. http://localhost:11434 for Ollama
# POLARIS_MODEL=            # default: claude-sonnet-5-5 (demo with POLARIS_PROVIDER=fake)
# OPENAI_BASE_URL=          # default base URL of OpenAI providers saved without one
# POLARIS_OAUTH_PORT=1455   # preferred ChatGPT callback port (fallback: available port)

# Provider egress (server/egress.ts): plain http only on this machine or a private network, never cloud metadata.
# POLARIS_ALLOW_HTTP_PROVIDERS=1   # allow http to a public address (the key would travel unencrypted)
# NODE_EXTRA_CA_CERTS=/path/ca.pem # private CA for an internal LiteLLM proxy / gateway
# POLARIS_ALLOW_INSECURE_TLS=1     # start even with NODE_TLS_REJECT_UNAUTHORIZED=0 (don't)

# Slack incoming webhook: "ready for review" and "failed" pings with a link to the ticket
# POLARIS_SLACK_WEBHOOK=https://hooks.slack.com/services/...

# Tests only
# POLARIS_PROVIDER=fake     # scripted demo provider
# POLARIS_SANDBOX=host      # run commands on the host: no isolation at all
# POLARIS_COMPACT_AT=       # compaction threshold override (tokens)
# POLARIS_RETRY_BASE_MS=1000
# POLARIS_OPENAI_AUTH_URL=  # ChatGPT identity and public inference URLs (mocks)
# POLARIS_OPENAI_PLAN_URL=
# POLARIS_OPENROUTER_URL=   # OpenRouter mock
# E2E_PORT=3200 HEADED=1 REAL_MODEL=<ollama model>   # npm run e2e
