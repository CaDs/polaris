{
  "name": "polaris",
  "version": "1.0.0",
  "scripts": {
    "test": "DB_PATH=:memory: POLARIS_OPEN_SIGNUP=1 POLARIS_SECRET_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff BETTER_AUTH_URL=http://localhost:3000 BETTER_AUTH_SECRET=test-only-auth-secret-not-used-anywhere-else node --test 'test/**/*.test.ts'",
    "dev": "concurrently -k -n api,web \"node --watch --env-file-if-exists=.env server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc",
    "agent": "node --env-file-if-exists=.env server/cli/agent.ts",
    "seed-tasks": "node --env-file-if-exists=.env server/cli/seed-tasks.ts",
    "bench": "node --env-file-if-exists=.env bench/run.ts",
    "e2e": "playwright test",
    "e2e:headed": "HEADED=1 playwright test"
  },
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "better-auth": "^1.7.7",
    "hono": "^4.13.12",
    "jose": "6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
